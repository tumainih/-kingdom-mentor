GEMINI_API_KEY=

# Public site URL — set on Render when you know your link (used for copy/share on /install)
# Example: https://kingdom-mentor.onrender.com
# NEXT_PUBLIC_SITE_URL=

# Optional: override the default model
# GEMINI_MODEL=gemini-3.6-flash

# Web Push — required for notifications when app is closed
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron auth (set in Vercel dashboard; cron runs hourly)
CRON_SECRET=

# Optional: Upstash Redis for push subscriptions in production
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
