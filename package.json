{
  "name": "kingdom-mentor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare-offline && next dev --port 43123 --hostname 0.0.0.0",
    "prepare-bible": "node scripts/prepare-bible.mjs",
    "prepare-swahili": "node scripts/prepare-swahili.mjs",
    "build-verse-pools": "node scripts/build-verse-pools.mjs",
    "prepare-offline": "node scripts/build-verse-pools.mjs && node scripts/prepare-offline.mjs",
    "prepare-pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "build": "npm run prepare-offline && next build && node scripts/generate-sw.mjs",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "deploy:render": "echo 'Connect https://github.com/tumainih/-kingdom-mentor on Render — see DEPLOY.md'",
    "deploy:netlify": "npm run build && npx netlify deploy --prod",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/generative-ai": "^0.24.1",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
